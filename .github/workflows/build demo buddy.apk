
name: Build Demo Buddy APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'DemoBuddyAndroid_Source.zip'
      - '.github/workflows/build-apk.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - uses: android-actions/setup-android@v4
        with:
          packages: 'platform-tools platforms;android-35 build-tools;35.0.0'

      - name: Unpack Android project
        run: |
          mkdir -p appsrc
          unzip -q DemoBuddyAndroid_Source.zip -d appsrc
          test -f appsrc/settings.gradle.kts

      - name: Fix Java and Kotlin compatibility
        run: |
          python3 - <<'PY'
          from pathlib import Path
          p = Path("appsrc/app/build.gradle.kts")
          s = p.read_text()
          s = s.replace(
              '    defaultConfig {',
              '    compileOptions {\n        sourceCompatibility = JavaVersion.VERSION_17\n        targetCompatibility = JavaVersion.VERSION_17\n    }\n    defaultConfig {'
          )
          p.write_text(s)
          PY

      - name: Build APK
        run: gradle -p appsrc --no-daemon assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: DemoBuddy-APK
          path: appsrc/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 7
